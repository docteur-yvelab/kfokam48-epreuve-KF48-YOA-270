# Maven Wrapper Script
# This script allows you to run Maven without having Maven installed.
# It downloads the Maven distribution if needed and runs it.

set -e

MAVEN_PROJECT_BASEDIR=$(dirname "$0")
MAVEN_PROJECT_BASEDIR=$(cd "$MAVEN_PROJECT_BASEDIR" && pwd -P)

WRAPPER_DIR="$MAVEN_PROJECT_BASEDIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPERTIES="$WRAPPER_DIR/maven-wrapper.properties"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.1/maven-wrapper-3.3.1.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    mkdir -p "$WRAPPER_DIR"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR"
    else
        echo "Error: curl or wget required to download Maven Wrapper"
        exit 1
    fi
fi

exec java -jar "$WRAPPER_JAR" "$@"